// -profile test_stub (alias: test): every required param points at the tiny dummy files
// under tests/nextflow/, so that
//     nextflow run main.nf -stub -profile test_stub
// exercises the channel wiring of every stage (QC, joint calling, DNM detection, mosaic,
// annotation, somatic, CH screen, MultiQC, provenance) without real data or containers.
// tests/nextflow/params_fastq.yaml adds the FASTQ/ALIGN path. The files are placeholders:
// a real (non-stub) run with this profile fails.

params {
    samplesheet            = "${projectDir}/tests/nextflow/samplesheet.csv"
    fasta                  = "${projectDir}/tests/nextflow/ref/genome.fa"
    somalier_sites         = "${projectDir}/tests/nextflow/resources/somalier_sites.vcf.gz"
    verifybamid_svd_prefix = "${projectDir}/tests/nextflow/resources/vbid"
    vcfanno_toml           = "${projectDir}/tests/nextflow/resources/vcfanno.toml"
    exclude_beds           = ["${projectDir}/tests/nextflow/resources/exclude.bed"]
    vep_cache              = "${projectDir}/tests/nextflow/resources/vep_cache"
    gene_table             = "${projectDir}/conf/gene_table.example.tsv"
    parental_ages          = [FAM001: [34, 31]]
    run_mosaic             = true
    mf_umap_bigwig         = "${projectDir}/tests/nextflow/resources/umap.bw"
    mf_model               = "${projectDir}/tests/nextflow/resources/mf_model.rds"
    run_somatic            = true
    run_ch_screen          = true
    germline_resource      = "${projectDir}/tests/nextflow/resources/af-only-gnomad.vcf.gz"
    m2_pon                 = "${projectDir}/tests/nextflow/resources/m2_pon.vcf.gz"
    common_biallelic       = "${projectDir}/tests/nextflow/resources/small_exac_common.vcf.gz"
    ch_genes_bed           = "${projectDir}/tests/nextflow/resources/ch_genes.bed"
    known_sites            = ["${projectDir}/tests/nextflow/resources/known_sites.vcf.gz"]
}

process {
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
}
