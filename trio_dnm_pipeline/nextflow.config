// Trio DNM pipeline v2.0 configuration. Resource paths are placeholders —
// override them in a params file (-params-file) rather than editing here.
//
// Containers and file visibility (-profile docker / -profile singularity):
//   * Every resource file below is handed to the processes as a staged `path` input
//     (together with its .tbi/.csi/.idx/.fai/.gzi index when one sits next to it), never
//     as a host path inside a command string. Nextflow therefore mounts it into the
//     container (and copies it on cloud executors); no bind mounts are needed. The files
//     named in params.vcfanno_toml are staged too and the TOML is rewritten to the staged
//     names at run time; directory resources (vep_cache, vep_plugin_dir,
//     vep_plugins.loftee_dir) are staged as directories.
//   * trio-dnm tasks stage the package (<projectDir>/trio_dnm) into the task directory
//     as pylib/trio_dnm and put it on PYTHONPATH, so they run in any image with
//     python3 >= 3.10 and `ps` (procps; Nextflow needs it for the trace/report metrics):
//     params.containers.trio_dnm, default python:3.11. The bundled Dockerfile builds a
//     smaller image with the package installed (`docker build -t trio-dnm:2.0.0 .`); to
//     use it set params.containers.trio_dnm = 'trio-dnm:2.0.0' in a -c config file (a
//     `containers:` map in a -params-file replaces the whole map). The python bin/
//     scripts (dng2tsv.py, vcf2mfbed.py) also run in this image.
//   * Do not add `-v ${projectDir}:...` or other bind mounts to docker.runOptions:
//     Nextflow already mounts bin/, the work directory and every staged input, and Docker
//     aborts a task whose mount points are duplicated.

manifest {
    name            = 'trio-dnm-pipeline'
    version         = '2.0.0'
    nextflowVersion = '>=24.04.0'           // process.resourceLimits
    mainScript      = 'main.nf'
}

params {
    samplesheet      = null                 // see the header of main.nf
    outdir           = 'results'
    publish_dir_mode = 'copy'
    fasta            = null                 // GRCh38 no-alt analysis set (+ .fai, .dict)
    build            = 'GRCh38'
    data_type        = 'wgs'                // wgs | wes | panel
    intervals        = null                 // capture targets for WES/panel
    targets          = null                 // BED for mosdepth / CNVkit (default: intervals)
    interval_padding = 100
    calling_contigs  = ((1..22).collect { "chr${it}" } + ['chrX', 'chrY'])
    pcr_free         = true

    // Stage 2 (FASTQ samplesheet rows only)
    known_sites      = []                   // BQSR: dbSNP, Mills/1000G gold indels, 1KG SNVs (+ .tbi)
    bwamem2_index    = null                 // index prefix; default params.fasta (<fasta>.0123/.amb/.ann/.bwt.2bit.64/.pac)

    // Stage 1
    qc_halt                = true           // false: report failed gates (QC_GATE, Mendelian error rate) without halting
    verifybamid_svd_prefix = null           // e.g. resource/1000g.phase3.100k.b38.vcf.gz.dat
    somalier_sites         = null           // sites.hg38.vcf.gz

    // Stages 4-5
    exclude_beds       = []                 // ENCODE blacklist v2, GIAB difficult regions, segdups, in-house masks
    pon                = null               // optional extra PoN VCF for `trio-dnm call --pon` (vcfanno already adds INFO/PON_AF)
    recurrence         = null
    dnm_config         = null               // JSON overriding trio_dnm defaults (conf/defaults.json)
    vcfanno_toml       = "${projectDir}/conf/vcfanno.toml"
    dng_min_pp         = 0.5
    triodenovo_min_dq  = 7

    // Stage 7
    run_mosaic      = true
    mosaic_min_vaf  = 0.03
    mf_umap_bigwig  = null                  // k24.umap.wg.bw (MosaicForecast)
    mf_model        = null                  // models_trained/250xRFmodel_addRMSK_Refine.rds (SNV model)

    // Stage 8
    vep_cache        = null
    vep_plugin_dir   = null
    vep_merged_cache = false
    vep_plugins = [
        loftee_dir: null, loftee_ancestor: null, loftee_sql: null,
        cadd_snv: null, cadd_indel: null, revel: null, alphamissense: null,
        spliceai_snv: null, spliceai_indel: null, dbnsfp: null, utrannotator: null,
        gnomad: null, clinvar: null, ccre_bed: null,
    ]
    gene_table       = null                 // see conf/gene_table.example.tsv
    phenotype_scores = null                 // dir of <family>.tsv (gene<TAB>score) from Exomiser/LIRICAL
    validated        = null
    parental_ages    = [:]                  // [FAM001: [34, 31]] father, mother age at conception
    cosmic_sbs       = null                 // COSMIC_v3.4_SBS_GRCh38.txt

    // Stage 9 (protocol §11): somatic + CH screen (§11.7)
    run_somatic       = false
    run_ch_screen     = false
    germline_resource = null                // af-only-gnomad.hg38.vcf.gz
    m2_pon            = null                // 1000g_pon.hg38.vcf.gz or in-house
    common_biallelic  = null                // small_exac_common_3.hg38.vcf.gz
    tumor_purity      = null
    ffpe              = false
    ch_genes_bed      = null

    // Upper bounds for the per-label requests below (they grow with each retry).
    max_cpus   = 32
    max_memory = '256.GB'
    max_time   = '7.d'

    // Containers: pin every image to the exact tag or digest you validated.
    containers = [
        trio_dnm       : 'python:3.11',     // or the Dockerfile image; needs python3 >= 3.10 + procps
        fastqc         : 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0',
        fastp          : 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0',
        // bwa-mem2 2.2.1 + samtools 1.19.2
        bwamem2        : 'quay.io/biocontainers/mulled-v2-e5d375990341c5aef3c9aff74f96f66f65375ef6:2d15960ccea84e249a150b7f5d4db3a42fc2d6c3-0',
        multiqc        : 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0',
        gatk           : 'broadinstitute/gatk:4.6.1.0',
        deeptrio       : 'google/deepvariant:deeptrio-1.8.0',
        glnexus        : 'ghcr.io/dnanexus-rnd/glnexus:v1.4.1',
        deepsomatic    : 'google/deepsomatic:1.8.0',
        bcftools       : 'quay.io/biocontainers/bcftools:1.21--h3a4d415_1',
        vcfanno        : 'quay.io/biocontainers/vcfanno:0.3.5--h9ee0642_0',
        mosdepth       : 'quay.io/biocontainers/mosdepth:0.3.10--h4e814b3_1',
        verifybamid2   : 'quay.io/biocontainers/verifybamid2:2.0.1--hbb20b25_6',
        somalier       : 'brentp/somalier:v0.2.19',
        denovogear     : 'quay.io/biocontainers/denovogear:1.1.1--0',
        triodenovo     : 'quay.io/biocontainers/triodenovo:0.06--0',
        vep            : 'ensemblorg/ensembl-vep:release_113.0',
        unfazed        : 'quay.io/biocontainers/unfazed:1.0.2--pyhdfd78af_0',
        mosaicforecast : 'yanmei/mosaicforecast:0.0.1',
        manta          : 'quay.io/biocontainers/manta:1.6.0--h9ee0642_1',
        strelka        : 'quay.io/biocontainers/strelka:2.9.10--h9ee0642_1',
        cnvkit         : 'etal/cnvkit:0.9.11',
    ]
}

process {
    // trio-dnm is pure Python 3.10+ (no dependencies); see the header for how it is staged.
    // Every script process also names its image explicitly (params.containers.<tool>).
    container = params.containers.trio_dnm
    shell     = ['/bin/bash', '-euo', 'pipefail']
    // Retried exit codes are OOM / time-limit / scheduler kills, so each attempt gets
    // proportionally more memory and time (capped by resourceLimits).
    withLabel: small  { cpus = 2;  memory = { 8.GB * task.attempt };  time = { 4.h * task.attempt } }
    withLabel: medium { cpus = 8;  memory = { 32.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: large  { cpus = 16; memory = { 64.GB * task.attempt }; time = { 48.h * task.attempt } }
    errorStrategy  = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }
    maxRetries     = 2
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
}

profiles {
    docker      { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)' }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    // Dry run of every stage on dummy inputs: nextflow run main.nf -stub -profile test_stub
    test_stub   { includeConfig 'tests/nextflow/test_stub.config' }
    test        { includeConfig 'tests/nextflow/test_stub.config' }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv"; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html"; overwrite = true }
